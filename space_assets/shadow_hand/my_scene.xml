<mujoco model="right_shadow_hand custom scene">
  <!-- Load the mechanical physics model from menagerie -->
  <include file="right_hand.xml"/>

  <statistic extent="0.3" center="0.3 0 0"/>

  <!-- ============================================================ -->
  <!-- Look & feel: high-contrast monochrome (Ghost in the Shell /  -->
  <!-- Scavengers Reign). Near-black void, faint cool grid floor,   -->
  <!-- single cool-white key light + minimal cool fill. No haze.    -->
  <!-- ============================================================ -->

  <visual>
    <!-- 8192 is appropriate for desktop captures but dominates CPU Basic
         rendering time. 512 keeps the contact shadow legible in a Space. -->
    <quality shadowsize="512"/>
    <global azimuth="140" elevation="-0"/>
  </visual>

  <asset>
    <!-- Pure black sky with a barely-there vertical gradient. -->
    <texture type="skybox" builtin="gradient"
             rgb1="0.025 0.030 0.040"
             rgb2="0.000 0.000 0.000"
             width="512" height="8072"/>

    <!-- Almost-invisible grid floor: anchors the hand visually
         without competing with it. Cool blue-grey grid lines on
         near-black squares. -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.040 0.050 0.060"
             rgb2="0.055 0.065 0.075"
             markrgb="0.18 0.22 0.28"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="14 14" reflectance="0.0" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- Key light: cool white, hard angle, sharp specular for that
         android / wet-plastic anime sheen. -->
    <light pos="0.25 -0.20 1.10" dir="-0.25 0.20 -1.00" directional="true"
           diffuse="0.95 0.97 1.00"
           specular="0.65 0.70 0.80"/>

    <!-- Tiny cool fill so the shadow side isn't pure void. -->
    <light pos="-0.20 0.20 0.50" dir="0.20 -0.20 -0.50" directional="true"
           diffuse="0.10 0.12 0.16"
           specular="0.0 0.0 0.0"/>

    <!-- Fixed framing for the server-side renderer: whole hand, no viewer
         free-camera state, and no floor-dominated default view. -->
    <camera name="teleop_camera" pos="0.42 -0.55 0.34"
            xyaxes="0.794 0.608 0 -0.120 0.157 0.981" fovy="35"/>

    <!-- Floor plane for shadow casting -->
    <geom name="floor" pos="0 0 -0.2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ============================================================ -->
    <!-- Calibration slider mechanism.                                -->
    <!--                                                              -->
    <!-- These bodies are invisible (no geoms). They exist only as    -->
    <!-- attachment points for the slide joints, which the position   -->
    <!-- actuators in <actuator> below drive. The user interacts via  -->
    <!-- the viewer's right-side Control panel; dragging the visible  -->
    <!-- in-scene widgets never worked because the position actuators -->
    <!-- (kp=50) overpower the mouse-drag force.                      -->
    <!-- ============================================================ -->
    <body pos="0 0 -1.0"><joint name="j_curl_scale"    type="slide" axis="0 0 1" range="0 0.20"/><inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/></body>
    <body pos="0 0 -1.0"><joint name="j_spread_scale"  type="slide" axis="0 0 1" range="0 0.20"/><inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/></body>
    <body pos="0 0 -1.0"><joint name="j_thumb_scale"   type="slide" axis="0 0 1" range="0 0.20"/><inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/></body>
    <body pos="0 0 -1.0"><joint name="j_smoothing"     type="slide" axis="0 0 1" range="0 0.20"/><inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/></body>
    <body pos="0 0 -1.0"><joint name="j_synergy_blend" type="slide" axis="0 0 1" range="0 0.20"/><inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/></body>
  </worldbody>

  <!-- ============================================================ -->
  <!-- Position actuators that drive the slider widgets.            -->
  <!-- These show up in the MuJoCo viewer's right-side "Control"    -->
  <!-- panel as draggable sliders (the canonical native UI).        -->
  <!-- main.py reads data.ctrl[<id>] each frame and applies as a    -->
  <!-- multiplicative scale on ACTUATOR_MAP gains.                  -->
  <!-- ============================================================ -->
  <actuator>
    <position name="ctl_curl_scale"    joint="j_curl_scale"    kp="50" ctrlrange="0 0.20"/>
    <position name="ctl_spread_scale"  joint="j_spread_scale"  kp="50" ctrlrange="0 0.20"/>
    <position name="ctl_thumb_scale"   joint="j_thumb_scale"   kp="50" ctrlrange="0 0.20"/>
    <position name="ctl_smoothing"     joint="j_smoothing"     kp="50" ctrlrange="0 0.20"/>
    <position name="ctl_synergy_blend" joint="j_synergy_blend" kp="50" ctrlrange="0 0.20"/>
  </actuator>
</mujoco>
